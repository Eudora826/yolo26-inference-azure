__pycache__/
*.pyc
.git/
.github/
tests/
*.md
.venv/
venv/
# The Dockerfile fetches the weights at build time instead of copying them
# from the build context, so yolov8n.pt needs no exception here.
#
# Do not exclude loadgen/ or *.jpg here: the loadgen build context is also
# the repo root (see build.context in docker-compose.yml), so it shares this
# .dockerignore with the main image, and excluding them breaks its COPY.
*.pt
.pytest_cache/
*.mp4
