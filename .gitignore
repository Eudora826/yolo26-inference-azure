__pycache__/
*.pyc
.venv/
venv/
*.pt
.pytest_cache/
.ruff_cache/
.DS_Store
*.egg-info/

# Local secrets (API keys, connection strings) stay out of git.
# A placeholder-only .env.example may be committed to document the variables.
.env
.env.*
!.env.example

# Video inputs and annotated outputs: multi-MB binaries stay out of git.
# Test videos are generated on the fly by tests/, and loadgen synthesizes its own.
*.mp4
*.avi
*.mov
*.mkv

# docs/ is published for README screenshots only. Anything else in docs/
# (personal study notes) stays local and out of git.
docs/*
!docs/images/

# Scratch files from the dependency reconciliation
local.txt
container.txt
